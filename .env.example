# SMTP Configuration for Contact Form
# Fill these in with your email provider settings (e.g., Google Workspace, Outlook, AWS SES, SendGrid)

# The SMTP Server (e.g., smtp.gmail.com)
SMTP_HOST=smtp.your-email-provider.com

# SMTP Port (Usually 587 for TLS, or 465 for SSL)
SMTP_PORT=587

# Use SSL/TLS (Set to "true" if using port 465)
SMTP_SECURE=false

# Your SMTP Username (usually your email address)
SMTP_USER=hello@neptuneitech.com

# Your SMTP Password or App-Specific Password
SMTP_PASS=your-secure-password

# The email address that the email will appear to come from
SMTP_FROM_EMAIL=website@neptuneitech.com

# The email address where you want to RECEIVE the leads
SMTP_TO_EMAIL=leads@neptuneitech.com

